# /*!
# ****************************
# \file       Doxyfile
# \brief      Doxygen configuration for the STM32F7508-DK bare-metal firmware.
# \author     Z. BEN-AKKA
# \version    1.3
# \date       11/10/2026
#
# \details
#   Generates HTML documentation for dev/ (applications, drivers, host tools)
#   and boards/ (board support). Run from the repository root:
#   make documentation.
#   Output goes to work/doc/html, which is never pushed.
#
# \remarks
#   Paths are relative to the repository root, where make runs doxygen.
#   Python is parsed natively; nothing here needs an input filter.
#
# \section doxyfile_version_history Version history
# | Version | Date       | Author      | Description                               |
# |:-------:|:----------:|:------------|:------------------------------------------|
# | 1.0     | 10/10/2026 | Z. BEN-AKKA | Initial configuration.                    |
# | 1.1     | 10/10/2026 | Z. BEN-AKKA | No Graphviz; strip GCC attributes.        |
# | 1.2     | 10/10/2026 | Z. BEN-AKKA | benakka-tech.fr theme, main page, images. |
# | 1.3     | 11/10/2026 | Z. BEN-AKKA | Inputs from dev/ and boards/.             |
# ****************************
# */

# --- Project ---
PROJECT_NAME            = "STM32F7508-DK bare-metal"
PROJECT_BRIEF           = "Register-level C firmware for the STM32F750N8, no HAL"
OUTPUT_DIRECTORY        = work/doc
GENERATE_HTML           = YES
GENERATE_LATEX          = NO
QUIET                   = YES
WARN_LOGFILE            = work/doc/doxygen.warnings

# --- Inputs: dev/docs/mainpage.md is the landing page ---
INPUT                   = dev/docs dev/apps dev/common dev/tools dev/scripts boards
RECURSIVE               = YES
FILE_PATTERNS           = *.md *.h *.c *.py
USE_MDFILE_AS_MAINPAGE  = dev/docs/mainpage.md

# --- Images: \image html name.svg "caption", or ![caption](name.png) ---
IMAGE_PATH              = dev/docs/images

# --- Look: theme matching benakka-tech.fr (dev/scripts/doxygen) ---
HTML_HEADER             = dev/scripts/doxygen/header.html
HTML_FOOTER             = dev/scripts/doxygen/footer.html
HTML_EXTRA_STYLESHEET   = dev/scripts/doxygen/theme.css
HTML_EXTRA_FILES        = dev/scripts/doxygen/logo.png \
                          dev/scripts/doxygen/fonts/atkinson-regular.woff \
                          dev/scripts/doxygen/fonts/atkinson-bold.woff
HTML_COLORSTYLE_HUE     = 216
HTML_COLORSTYLE_SAT     = 150
HTML_COLORSTYLE_GAMMA   = 90
GENERATE_TREEVIEW       = YES

# --- Exclude ---
EXCLUDE                 = work

JAVADOC_AUTOBRIEF       = YES
MULTILINE_CPP_IS_BRIEF  = YES
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = YES
EXTRACT_STATIC          = YES
OPTIMIZE_OUTPUT_FOR_C   = YES

# --- Preprocessing: expand only the macros listed in PREDEFINED ---
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = YES
# GCC attributes before a function name hide the name from the parser
PREDEFINED              = "__attribute__(x)="
PREDEFINED             += $(DOXY_PREDEFINED)

# --- Graphs: need Graphviz (sudo apt install graphviz), then set YES ---
HAVE_DOT                = NO
